# Copy to .env on the host and fill in. Never commit the real file.
#
#   cp .env.example .env && chmod 600 .env

COURTOPS_DOMAIN=courtops.example.com
COURTOPS_IMAGE=courtops:0.1.0

# openssl rand -base64 32
POSTGRES_PASSWORD=
COURTOPS_SESSION_SECRET=

# Comma separated Google account emails allowed to operate events.
COURTOPS_ORGANIZERS=you@example.com,cooperator@example.com

# From the Google Cloud console. Create a "Web application" OAuth client; a
# Desktop client is a different client type and will not work here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# true until organizer sign-in has been verified on the real host (Session 8/9).
COURTOPS_READ_ONLY=true

# Turn on only after the pilot, so a confusing first evening cannot bake bad
# numbers into player history.
COURTOPS_RATINGS=false

TZ=America/Chicago

# Optional dual-stack Docker bridge: see docs/IPV6.md before enabling.
COURTOPS_DUAL_STACK=false
COURTOPS_DOCKER_IPV4_SUBNET=172.30.40.0/24
COURTOPS_DOCKER_IPV6_SUBNET=fd62:3ab9:70c1::/64
