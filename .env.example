# Local development. Copy to .env and adjust; `make run` sets these itself, so
# this file is mainly a reference for what the app reads.

DATABASE_URL=postgres://courtops:courtops@localhost:5433/courtops?sslmode=disable
COURTOPS_ENV=development
COURTOPS_ADDR=:8080
COURTOPS_BASE_URL=http://localhost:8080

# Signs the organizer session cookie. Any 32+ byte string locally;
# `openssl rand -base64 32` in production.
COURTOPS_SESSION_SECRET=local-development-secret-32-bytes-long

# Who may operate events.
COURTOPS_ORGANIZERS=dev@example.com

# Signs in as this account without contacting Google. Development only: the app
# refuses to start in production if this is set.
COURTOPS_DEV_ORGANIZER=dev@example.com

# Google sign-in (leave empty locally). Create a "Web application" OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=

# Serve the board but refuse every write. Used for the public synthetic demo.
COURTOPS_READ_ONLY=false

# Persist Elo changes when a match is completed.
COURTOPS_RATINGS=true
